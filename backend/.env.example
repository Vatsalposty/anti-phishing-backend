# --- Backend Configuration ---
# Set this to "true" in production, or "false" to allow localhost requests
PRODUCTION_MODE=true

# --- Firebase Configuration ---
# In production, provide the JSON content as a single line string.
# In local development, you can just have `serviceAccountKey.json` in the backend folder.
FIREBASE_CREDENTIALS=

# --- External APIs ---
# (Optional) Add your API keys if implemented
# PHISHTANK_API_KEY=
# URLSCAN_API_KEY=

# --- Security ---
# Secret for triggering manual model retraining remotely
# RETRAIN_SECRET=your_secure_random_string_here
